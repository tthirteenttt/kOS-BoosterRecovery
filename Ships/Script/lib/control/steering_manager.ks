// ============================================================================
// kOS SteeringManager Phase-Scheduled Profiles v0.8
// ============================================================================

// Phase 1: Vacuum flip, coast & 3-engine burns
FUNCTION configure_steering_vacuum {
    PARAMETER sm_cfg.

    STEERINGMANAGER:RESETPIDS().
    SET STEERINGMANAGER:MAXSTOPPINGTIME TO 1.2.
    SET STEERINGMANAGER:PITCHTS TO 4.0.
    SET STEERINGMANAGER:YAWTS TO 4.0.
    SET STEERINGMANAGER:ROLLTS TO 8.0.

    SET STEERINGMANAGER:PITCHPID:KP TO 0.9.
    SET STEERINGMANAGER:YAWPID:KP TO 0.9.
    SET STEERINGMANAGER:PITCHPID:KI TO 0.0.
    SET STEERINGMANAGER:YAWPID:KI TO 0.0.
    SET STEERINGMANAGER:PITCHPID:KD TO 0.0.
    SET STEERINGMANAGER:YAWPID:KD TO 0.0.

    SET STEERINGMANAGER:ROLLPID:KP TO 0.15.
    SET STEERINGMANAGER:ROLLPID:KI TO 0.0.
    SET STEERINGMANAGER:ROLLPID:KD TO 0.0.

    SET STEERINGMANAGER:ROLLTORQUEFACTOR TO 5.0.
    SET STEERINGMANAGER:PITCHTORQUEFACTOR TO 1.0.
    SET STEERINGMANAGER:YAWTORQUEFACTOR TO 1.0.
    SET STEERINGMANAGER:TORQUEEPSILONMIN TO 0.008.
    SET STEERINGMANAGER:TORQUEEPSILONMAX TO MAX(0.025, sm_cfg["TORQUE_EPSILON_MAX"]).
    SET STEERINGMANAGER:ROLLCONTROLANGLERANGE TO -1.0.
}

// Phase 2: Dense atmospheric aerodynamic glide
FUNCTION configure_steering_aero {
    PARAMETER sm_cfg.

    STEERINGMANAGER:RESETPIDS().
    SET STEERINGMANAGER:MAXSTOPPINGTIME TO sm_cfg["MAX_STOPPING_TIME"].
    SET STEERINGMANAGER:PITCHTS TO sm_cfg["PITCH_TS"].
    SET STEERINGMANAGER:YAWTS TO sm_cfg["YAW_TS"].
    SET STEERINGMANAGER:ROLLTS TO sm_cfg["ROLL_TS"].

    SET STEERINGMANAGER:PITCHPID:KP TO 2.2.
    SET STEERINGMANAGER:YAWPID:KP TO 2.2.
    SET STEERINGMANAGER:PITCHPID:KI TO 1.5.
    SET STEERINGMANAGER:YAWPID:KI TO 1.5.
    SET STEERINGMANAGER:PITCHPID:KD TO sm_cfg["PID_KD"].
    SET STEERINGMANAGER:YAWPID:KD TO sm_cfg["PID_KD"].

    SET STEERINGMANAGER:ROLLPID:KP TO 0.5.
    SET STEERINGMANAGER:ROLLPID:KI TO 0.0.
    SET STEERINGMANAGER:ROLLPID:KD TO 1.5.

    SET STEERINGMANAGER:PITCHTORQUEADJUST TO 0.0.
    SET STEERINGMANAGER:YAWTORQUEADJUST TO 0.0.
    SET STEERINGMANAGER:ROLLTORQUEADJUST TO 0.0.
    SET STEERINGMANAGER:ROLLTORQUEFACTOR TO 1.0.
    SET STEERINGMANAGER:PITCHTORQUEFACTOR TO 1.0.
    SET STEERINGMANAGER:YAWTORQUEFACTOR TO 1.0.
    SET STEERINGMANAGER:TORQUEEPSILONMIN TO 0.0002.
    SET STEERINGMANAGER:TORQUEEPSILONMAX TO sm_cfg["TORQUE_EPSILON_MAX"].
    SET STEERINGMANAGER:ROLLCONTROLANGLERANGE TO 180.0.
}

// Phase 3: Single-engine TVC Hoverslam landing (zero KI windup, crisp PITCHTS=0.9s settling)
FUNCTION configure_steering_landing {
    STEERINGMANAGER:RESETPIDS().
    SET STEERINGMANAGER:MAXSTOPPINGTIME TO 1.2.
    SET STEERINGMANAGER:PITCHTS TO 0.9.
    SET STEERINGMANAGER:YAWTS TO 0.9.
    SET STEERINGMANAGER:ROLLTS TO 6.0.

    SET STEERINGMANAGER:PITCHPID:KP TO 2.2.
    SET STEERINGMANAGER:YAWPID:KP TO 2.2.
    SET STEERINGMANAGER:PITCHPID:KI TO 0.0.
    SET STEERINGMANAGER:YAWPID:KI TO 0.0.
    SET STEERINGMANAGER:PITCHPID:KD TO 1.2.
    SET STEERINGMANAGER:YAWPID:KD TO 1.2.

    SET STEERINGMANAGER:ROLLPID:KP TO 0.15.
    SET STEERINGMANAGER:ROLLPID:KI TO 0.0.
    SET STEERINGMANAGER:ROLLPID:KD TO 0.0.
    SET STEERINGMANAGER:ROLLTORQUEFACTOR TO 5.0.
    SET STEERINGMANAGER:PITCHTORQUEFACTOR TO 1.0.
    SET STEERINGMANAGER:YAWTORQUEFACTOR TO 1.0.
    SET STEERINGMANAGER:TORQUEEPSILONMIN TO 0.002.
    SET STEERINGMANAGER:ROLLCONTROLANGLERANGE TO -1.0.
}

FUNCTION configure_steering_manager {
    PARAMETER sm_cfg.
    configure_steering_vacuum(sm_cfg).
}

FUNCTION restore_steering_manager {
    STEERINGMANAGER:RESETTODEFAULT().
}